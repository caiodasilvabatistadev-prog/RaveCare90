# Copy to .env locally; never commit actual values.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:8081
# Runtime uses a non-owner, non-superuser role with no BYPASSRLS.
DATABASE_URL=
# Separate migration/administration credential; never injected into the API.
MIGRATION_DATABASE_URL=
# 32 cryptographically random bytes, base64 encoded; store in secret manager.
DATA_ENCRYPTION_KEY=
# Optional alternatives: DATABASE_URL_FILE, MIGRATION_DATABASE_URL_FILE,
# DATA_ENCRYPTION_KEY_FILE point to mounted secret files.
