# Copie este arquivo para .env e substitua os valores antes de iniciar.
POSTGRES_DB=ravecare
POSTGRES_USER=ravecare_app
POSTGRES_PASSWORD=troque-por-uma-senha-local-forte
JWT_SECRET=gere-uma-chave-aleatoria-com-pelo-menos-32-caracteres
GOOGLE_CLIENT_ID=seu-client-id-do-google
APP_PUBLIC_URL=http://localhost:5173
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
MAIL_HOST=smtp.seu-provedor.com
MAIL_PORT=587
MAIL_USERNAME=seu-usuario-smtp
MAIL_PASSWORD=troque-por-uma-senha-ou-chave-smtp
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true

